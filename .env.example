# Server Settings
APP_NAME=CodeSentinel
DEBUG=True
PORT=8000

# Database Settings (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codesentinel
# For Docker Compose:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/codesentinel

# Redis Settings
REDIS_URL=redis://localhost:6379/0
# For Docker Compose:
# REDIS_URL=redis://redis:6379/0

# GitHub Integration Settings
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_TOKEN=your_github_personal_access_token_here

# AI Provider Settings (Gemini or OpenAI)
AI_PROVIDER=gemini  # "gemini" or "openai" or "mock"
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_MODEL=gemini-2.5-flash
